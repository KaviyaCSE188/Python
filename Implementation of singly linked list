class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
n1 = Node("PiraiThedum")
n2 = Node("Nenjorathil")
n3 = Node("Melliname")
n4 = Node("Un per solla")
n5 = Node("Kathaipoma")
n6 = Node("Mundhinam")
n1.next = n2
n2.next = n3
n3.next = n4
n4.next = n5
n5.next = n6
head = n1
def display(head):
    temp = head
    while temp != None:
        print(temp.data)
        temp = temp.next
    print("None")
print("Original linked list:")
display(head)
print("After insertion at beginning:")
new_node = Node("Nee partha")
new_node.next = head
head = new_node
display(head)
print("After insertion after Un per solla:")
new_node1 = Node("Aayiram Thadai")
temp = head
while temp.data != "Un per solla":
    temp = temp.next
new_node1.next = temp.next
temp.next = new_node1
display(head)
print("After insertion at end:")
new_node3 = Node("Kanalaney")
temp = head
while temp.next:
    temp = temp.next
temp.next = new_node3
display(head)
print("After deletion at beginning:")
head = head.next
display(head)
print("After deletion of Aayiram Thadai:")
temp = head
while temp.next.data != "Aayiram Thadai":
    temp = temp.next
temp.next = temp.next.next
display(head)
print("After deletion at end:")
temp = head
while temp.next.next:
    temp = temp.next
temp.next = None

display(head)
