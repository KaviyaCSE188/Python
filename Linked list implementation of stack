class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
class Stack:
    def __init__(self):
        self.top = None
    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        print(data, "pushed to stack")
    def pop(self):
        if self.top is None:
            return "Stack is empty"
        data = self.top.data
        self.top = self.top.next
        return data
    def peek(self):
        if self.top is None:
            return "Stack is empty"
        return self.top.data
b = Stack()
b.push("Harry Potter")
b.push("Jackson")
b.push("2 Stars")
print("1. Push")
print("2. Pop")
print("3. Peek")
choice = int(input("Enter the choice: "))
if choice == 1:
    a = input("Enter a book title to push: ")
    b.push(a)
elif choice == 2:
    removed = b.pop()
    print("Popped:", removed)
elif choice == 3:
    print("Top book is:", b.peek())
